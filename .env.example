# GEMINI_API_KEY: Required for server-side Gemini API calls (/api/gemini/engineer-prompt and /api/gemini/generate).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional Gemini model overrides (defaults: gemini-4-hydrogen primary, gemini-3.1-flash-lite fallback)
GEMINI_MODEL_PRIMARY="gemini-4-hydrogen"
GEMINI_MODEL_FALLBACK="gemini-3.1-flash-lite"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
